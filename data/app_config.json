{
  "app": {
    "name": "GeoDocs Scanner",
    "version": "32.3 PLUS",
    "debug": false,
    "log_level": "INFO"
  },
  "paths": {
    "data_dir": "data",
    "projects_dir": "proyectos",
    "temp_dir": "temp",
    "exports_dir": "exports"
  },
  "camera": {
    "default_resolution": [1920, 1080],
    "capture_quality": 95,
    "auto_focus": true,
    "default_format": "A4"
  },
  "ocr": {
    "default_language": "spa",
    "psm_mode": 3,
    "languages": ["spa", "lat", "eng"],
    "preprocess": true,
    "auto_rotate": true,
    "denoise": true,
    "confidence_threshold": 60.0
  },
  "tts": {
    "default_rate": 150,
    "default_volume": 0.9,
    "default_voice_lang": "es",
    "save_format": "wav"
  },
  "processing": {
    "auto_crop": true,
    "remove_fingers": true,
    "auto_brightness": true,
    "dewarp": false,
    "split_double_page": false
  },
  "export": {
    "formats": ["dc", "iiif", "tei", "geojson", "pdf"],
    "pdf_quality": 95,
    "embed_metadata": true,
    "validate_output": true
  },
  "ui": {
    "theme": "superhero",
    "font_family": "Open Sans",
    "font_size": 10,
    "show_tooltips": true,
    "confirm_actions": true
  },
  "api": {
    "config_file": "data/rest_config.json",
    "timeout": 20,
    "retry_attempts": 3
  }
}
